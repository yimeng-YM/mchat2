{
  "name": "mchat2",
  "private": true,
  "version": "0.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:android",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && vite build",
    "build:ui": "tsc -b && vite build",
    "sync:android": "npm run build:ui && cap sync android",
    "lint:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Task lintDebug",
    "test:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Task testDebugUnitTest",
    "build:android": "npm run sync:android && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Task assembleDebug",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@vitejs/plugin-react": "latest",
    "dexie": "^4.4.4",
    "lucide-react": "^0.468.0",
    "react": "latest",
    "react-dom": "latest",
    "tslib": "^2.8.1",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.8.0",
    "iconv-lite": "^0.7.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
